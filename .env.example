STEAM_API_KEY=your-key-here
STEAM_ID=your-steamid64-here
# Make your own long random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Where the site is reached (for the dev servers). Docker sets its own.
PUBLIC_URL=http://localhost:5173

# Password for the Postgres database Docker runs. Make one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me

# --- Only on the live server (used by compose.prod.yaml) ---
# Your site's real address, e.g. https://achievementshowcase.com
# PUBLIC_URL=https://your-domain-here
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=
